{
  "compilerOptions": {
    "rootDir": "../../",
    "outDir": "dist",
    "paths": {
      "@/models/*": ["./models/*"],
      "@pc-builder/shared": ["../../packages/shared"],
      "@pc-builder/shared/*": ["../../packages/shared/*"],
      "src/*": ["./src/*"]
    },
    "target": "ES2021",
    "allowJs": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "incremental": true,
    "module": "node16",
    "esModuleInterop": true,
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "forceConsistentCasingInFileNames": true,
    "strictNullChecks": true
  },
  "include": ["**/*.ts", "**/*.tsx", "../../packages/shared/**/*.ts"],
  "exclude": ["node_modules", ".next", "app", "../../apps/frontend", "../../apps/crawler"]
}
