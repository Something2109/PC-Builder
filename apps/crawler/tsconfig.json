{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../../",
    "module": "CommonJS",
    "moduleResolution": "node",
    "paths": {
      "@/utils/*": ["../../packages/shared/*"]
