{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../../",
    "module": "node16",
    "moduleResolution": "node16",
    "paths": {
      "@pc-builder/shared": ["../../packages/shared"],
      "@pc-builder/shared/*": ["../../packages/shared/*"]
    }
  },
  "include": ["**/*.ts", "../../packages/shared/**/*.ts"],
  "exclude": ["node_modules", "dist", "logs"]
}
