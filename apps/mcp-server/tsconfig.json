{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../../",
    "module": "node16",
    "moduleResolution": "node16",
    "paths": {
      "@/utils/*": ["../../packages/shared/*"],
      "@pc-builder/shared": ["../../packages/shared/index.ts"]
