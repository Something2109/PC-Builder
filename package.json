{
  "name": "pc-builder-monorepo",
  "version": "1.0.0",
  "description": "PC Builder Monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "dev:backend": "npm run start:dev --workspace=apps/backend",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "build:backend": "npm run build --workspace=apps/backend",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:mcp": "npm run build --workspace=apps/mcp-server",
    "start:mcp": "npm run start --workspace=apps/mcp-server",
    "serve:mcp": "npm run serve --workspace=apps/mcp-server",
    "crawl": "npm run start --workspace=apps/crawler --",
    "install:all": "npm install",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/node": "^22.17.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-perfectionist": "^5.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.60.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{js,jsx,ts,tsx,css,md,json}": [
      "prettier --write"
    ]
  }
}
