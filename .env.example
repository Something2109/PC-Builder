# The env file for the deployment using docker compose file

## REQUIRED:

# The database's root password.
DATABASE_ROOT_PASSWORD=

# The database's user password of the Nestjs instance.
DATABASE_PASSWORD=

## OPTIONAL FOR TWEAKING:

# The database name that the nestjs app use.
# Declared in the Docker Compose file as "PC_Builder".
DATABASE_NAME=

# The username that the nestjs app use to access the database.
# Declared in the Docker Compose file as "NestjsApp".
DATABASE_USERNAME=

# The secret to be used for generating JWT token.
JWT_SECRET=

# The secret to be used for generating CSRF token.
CSRF_SECRET=
